# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Server-side admin passcode for /auth dashboard access.
# If left empty in preview, the first-run setup flow at /auth allows claiming an admin password.
ADMIN_PASSCODE=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional hosted Supabase backend persistence.
# When omitted, the server persists data reliably to local server storage (.data/portfolio-db.json).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
